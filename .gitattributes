# Every text file is LF in the repository and in the checkout, so a Windows checkout
# never commits CRLF. The recordings in fixtures/ are compared byte by byte.
* text=auto eol=lf

# Binary assets: never normalized.
*.png binary
*.gif binary
*.ico binary
*.nupkg binary
*.snupkg binary
*.svg text eol=lf

# Delphi sources keep CRLF: the IDE of 10.1 Berlin loses the line of a breakpoint with LF.
*.pas text eol=crlf
*.dpr text eol=crlf
*.dpk text eol=crlf
*.dproj text eol=crlf
*.dfm text eol=crlf
*.inc text eol=crlf

# Linguagem do repositório no GitHub: o que conta é a lib, não o ferramental.
# Sem isto os scripts Python de docs/ e tools/ fazem o repo aparecer como Python.
docs/** linguist-documentation
site/** linguist-documentation
tools/** linguist-vendored
